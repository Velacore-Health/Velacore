<section class="section" style="text-align:center;min-height:70vh;display:grid;place-items:center">
  <div class="container" style="max-width:40rem">
    <img class="brand-mark" src="{{ 'logo-mark.png' | asset_url }}" alt="{{ shop.name }}" style="height:44px;margin:0 auto 22px">
    <h1 style="font-size:clamp(2rem,5vw,3rem);margin-bottom:14px">{{ shop.name }}</h1>
    <p class="section-sub" style="margin-bottom:26px">{{ shop.password_message | default: 'Opening soon. Physician-directed peptide telehealth.' }}</p>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<p style="color:#ff9a9a;margin-bottom:12px">{{ form.errors.messages.form }}</p>{%- endif -%}
      <div style="display:flex;gap:10px;max-width:26rem;margin:0 auto;flex-wrap:wrap;justify-content:center">
        <input type="password" name="password" placeholder="Enter store password" style="flex:1;min-width:200px;padding:14px 16px;border-radius:12px;border:1px solid var(--line-dark-2);background:var(--ink-2);color:var(--on-dark);font:inherit">
        <button type="submit" class="btn btn-primary">Enter</button>
      </div>
    {%- endform -%}
  </div>
</section>
