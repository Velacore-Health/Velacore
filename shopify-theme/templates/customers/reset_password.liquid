<section class="section" style="min-height:60vh">
  <div class="container legal-wrap" style="max-width:460px">
    <div class="section-head"><p class="eyebrow">Account</p><h2>Reset your password</h2></div>
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <input type="password" name="customer[password]" placeholder="New password" style="width:100%;padding:13px 15px;margin-bottom:14px;border-radius:12px;border:1px solid var(--line-dark-2);background:var(--ink-2);color:var(--on-dark);font:inherit">
      <input type="password" name="customer[password_confirmation]" placeholder="Confirm password" style="width:100%;padding:13px 15px;margin-bottom:16px;border-radius:12px;border:1px solid var(--line-dark-2);background:var(--ink-2);color:var(--on-dark);font:inherit">
      <button type="submit" class="btn btn-primary btn-block">Reset password</button>
    {%- endform -%}
  </div>
</section>
