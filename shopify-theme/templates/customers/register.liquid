<section class="section" style="min-height:60vh">
  <div class="container legal-wrap" style="max-width:460px">
    <div class="section-head"><p class="eyebrow">Account</p><h2>Create account</h2></div>
    {%- form 'create_customer' -%}
      {{ form.errors | default_errors }}
      <input type="text" name="customer[first_name]" placeholder="First name" style="width:100%;padding:13px 15px;margin-bottom:14px;border-radius:12px;border:1px solid var(--line-dark-2);background:var(--ink-2);color:var(--on-dark);font:inherit">
      <input type="text" name="customer[last_name]" placeholder="Last name" style="width:100%;padding:13px 15px;margin-bottom:14px;border-radius:12px;border:1px solid var(--line-dark-2);background:var(--ink-2);color:var(--on-dark);font:inherit">
      <input type="email" name="customer[email]" placeholder="Email" required style="width:100%;padding:13px 15px;margin-bottom:14px;border-radius:12px;border:1px solid var(--line-dark-2);background:var(--ink-2);color:var(--on-dark);font:inherit">
      <input type="password" name="customer[password]" placeholder="Password" style="width:100%;padding:13px 15px;margin-bottom:16px;border-radius:12px;border:1px solid var(--line-dark-2);background:var(--ink-2);color:var(--on-dark);font:inherit">
      <button type="submit" class="btn btn-primary btn-block">Create account</button>
    {%- endform -%}
    <p class="section-sub" style="margin-top:18px;font-size:.9rem"><a href="{{ routes.account_login_url }}" style="color:var(--jade)">Already have an account? Log in</a></p>
  </div>
</section>
