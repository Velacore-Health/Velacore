<section class="legal-hero">
  <div class="container legal-wrap">
    <p class="eyebrow">{{ section.settings.eyebrow | default: 'Velacore Health' }}</p>
    <h1>{{ page.title }}</h1>
  </div>
</section>
<section class="legal-body">
  <div class="container legal-wrap rte">
    {{ page.content }}
  </div>
</section>

{% schema %}
{
  "name": "Page content",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Velacore Health" }
  ]
}
{% endschema %}
