<section class="hero">
  <canvas id="molecule" aria-hidden="true"></canvas>
  <div class="container hero-inner">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }} <span class="grad">{{ section.settings.heading_accent }}</span></h1>
    <p class="hero-lede">{{ section.settings.lede }}</p>
    <div class="hero-cta">
      <a href="{{ section.settings.primary_url | default: routes.all_products_collection_url }}" class="btn btn-primary btn-arrow">{{ section.settings.primary_label }}</a>
      <a href="{{ routes.root_url }}#how" class="btn btn-ghost">{{ section.settings.secondary_label }}</a>
    </div>
    <ul class="hero-chips">
      <li class="chip"><span class="dot"></span> Independent, licensed physicians</li>
      <li class="chip"><span class="dot"></span> 503A compounding pharmacies</li>
      <li class="chip"><span class="dot"></span> Prescription required</li>
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Physician-directed peptide telehealth" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Precision peptide therapy," },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (jade gradient)", "default": "reviewed by real physicians." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Velacore Health is a telehealth platform that connects you with independent, licensed physicians and 503A compounding pharmacies. Start an online visit — a physician reviews it and prescribes only when it's clinically appropriate." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Explore treatments" },
    { "type": "url", "id": "primary_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "How it works" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
