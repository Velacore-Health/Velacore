{%- liquid
  assign cta_url = settings.primary_cta_url | default: routes.all_products_collection_url
  assign intake_url = settings.intake_form_url | default: cta_url
  assign col = section.settings.collection
-%}
<section class="section on-cream" id="treatments">
  <div class="container">
    <div class="section-head center">
      <p class="eyebrow">Treatments</p>
      <h2>{{ section.settings.heading }}</h2>
      <p class="section-sub">{{ section.settings.subheading }}</p>
    </div>

    <div class="filters" role="tablist" aria-label="Filter treatments">
      <button class="filter is-active" data-filter="all">All</button>
      <button class="filter" data-filter="weight">Weight</button>
      <button class="filter" data-filter="vitality">Vitality</button>
      <button class="filter" data-filter="hormone">Hormone support</button>
    </div>

    <div class="tgrid" id="tgrid">
      {%- if col != blank and col.products_count > 0 -%}
        {%- for product in col.products -%}
          {%- liquid
            assign cat = 'all'
            if product.tags contains 'weight'
              assign cat = 'weight'
            elsif product.tags contains 'vitality'
              assign cat = 'vitality'
            elsif product.tags contains 'hormone'
              assign cat = 'hormone'
            endif
          -%}
          <article class="tcard" data-cat="{{ cat }}">
            <div class="tcard-media">
              {%- if cat != 'all' -%}<span class="tcard-cat">{{ cat | replace: 'hormone', 'Hormone support' | capitalize }}</span>{%- endif -%}
              {%- if product.featured_image -%}
                <img class="tcard-photo" src="{{ product.featured_image | image_url: width: 640 }}" alt="{{ product.title | escape }}" loading="lazy">
              {%- endif -%}
            </div>
            <div class="tcard-body">
              <h3>{{ product.title }}</h3>
              <p class="tcard-mech">{{ product.metafields.custom.mechanism | default: product.description | strip_html | truncatewords: 16 }}</p>
              <div class="tcard-meta">
                <span class="tcard-price">{% if product.price_varies %}From {% endif %}{{ product.price_min | money_without_trailing_zeros }} <small>/mo</small></span>
                <span class="tcard-rx">Rx only</span>
              </div>
              <a href="{{ product.url }}" class="btn btn-ghost btn-block btn-sm btn-arrow">View treatment</a>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Fallback cards shown until the Treatments collection is created {%- endcomment -%}
        <article class="tcard" data-cat="weight"><div class="tcard-media"><span class="tcard-cat">Weight</span><img class="tcard-photo" src="{{ 'tirzepatide.webp' | asset_url }}" alt="Tirzepatide" loading="lazy"></div><div class="tcard-body"><h3>Tirzepatide</h3><p class="tcard-mech">Dual GIP / GLP-1 receptor agonist. Monthly program.</p><div class="tcard-meta"><span class="tcard-price">From $349 <small>/mo</small></span><span class="tcard-rx">Rx only</span></div><a href="{{ cta_url }}" class="btn btn-ghost btn-block btn-sm btn-arrow">View treatment</a></div></article>
        <article class="tcard" data-cat="weight"><div class="tcard-media"><span class="tcard-cat">Weight</span><img class="tcard-photo" src="{{ 'semaglutide.webp' | asset_url }}" alt="Semaglutide" loading="lazy"></div><div class="tcard-body"><h3>Semaglutide</h3><p class="tcard-mech">GLP-1 receptor agonist. Monthly program.</p><div class="tcard-meta"><span class="tcard-price">From $299 <small>/mo</small></span><span class="tcard-rx">Rx only</span></div><a href="{{ cta_url }}" class="btn btn-ghost btn-block btn-sm btn-arrow">View treatment</a></div></article>
        <article class="tcard" data-cat="vitality"><div class="tcard-media"><span class="tcard-cat">Vitality</span><img class="tcard-photo" src="{{ 'nad.webp' | asset_url }}" alt="NAD+" loading="lazy"></div><div class="tcard-body"><h3>NAD+</h3><p class="tcard-mech">NAD+ injectable · 70-day supply.</p><div class="tcard-meta"><span class="tcard-price">$279 <small>/ 70-day</small></span><span class="tcard-rx">Rx only</span></div><a href="{{ cta_url }}" class="btn btn-ghost btn-block btn-sm btn-arrow">View treatment</a></div></article>
        <article class="tcard" data-cat="vitality"><div class="tcard-media"><span class="tcard-cat">Vitality</span><img class="tcard-photo" src="{{ 'glutathione.webp' | asset_url }}" alt="Glutathione" loading="lazy"></div><div class="tcard-body"><h3>Glutathione</h3><p class="tcard-mech">Glutathione injectable · monthly supply.</p><div class="tcard-meta"><span class="tcard-price">$199 <small>/mo</small></span><span class="tcard-rx">Rx only</span></div><a href="{{ cta_url }}" class="btn btn-ghost btn-block btn-sm btn-arrow">View treatment</a></div></article>
        <article class="tcard" data-cat="hormone"><div class="tcard-media"><span class="tcard-cat">Hormone support</span><img class="tcard-photo" src="{{ 'sermorelin.webp' | asset_url }}" alt="Sermorelin" loading="lazy"></div><div class="tcard-body"><h3>Sermorelin</h3><p class="tcard-mech">Growth hormone–releasing hormone analog · 56-day supply.</p><div class="tcard-meta"><span class="tcard-price">$329 <small>/ 56-day</small></span><span class="tcard-rx">Rx only</span></div><a href="{{ cta_url }}" class="btn btn-ghost btn-block btn-sm btn-arrow">View treatment</a></div></article>
        <article class="tcard" data-cat="all"><div class="tcard-media"><img class="tcard-photo" src="{{ 'start.webp' | asset_url }}" alt="Not sure where to start" loading="lazy"></div><div class="tcard-body"><h3>Not sure where to start?</h3><p class="tcard-mech">Start the online visit and an independent physician will help determine what's appropriate for you.</p><div class="tcard-meta"><span class="tcard-price">Free <small>to begin</small></span><span class="tcard-rx">No obligation</span></div><a href="{{ intake_url }}" class="btn btn-primary btn-block btn-sm btn-arrow"{% if intake_url contains "http" %} target="_blank" rel="noopener"{% endif %}>Start online visit</a></div></article>
      {%- endif -%}
    </div>

    <p class="treat-note">Prices reflect program cost. A one-time $20 physician fee applies; shipping is included. All medications are prescription only and dispensed by a licensed pharmacy following a physician's prescription. Final options are determined by your physician. Individual results vary. This page is not medical advice.</p>
  </div>
</section>

{% schema %}
{
  "name": "Treatments",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Treatments collection", "info": "Select the collection of your 5 program products. Until set, sample cards are shown." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your therapy. A physician decides the rest." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Every treatment is prescription only and reviewed by an independent, licensed physician. Pick where you want to start — your online visit takes it from there." }
  ],
  "presets": [{ "name": "Treatments" }]
}
{% endschema %}
