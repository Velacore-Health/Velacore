{%- assign img = section.settings.headshot -%}
<section class="section on-cream" id="provider">
  <div class="container provider-grid">
    <div class="tcard" style="box-shadow:var(--shadow-cream)">
      <div class="tcard-media" style="aspect-ratio:42/52">
        {%- if img != blank -%}
          <img class="tcard-photo" src="{{ img | image_url: width: 640 }}" alt="{{ section.settings.provider_name | escape }}">
        {%- else -%}
          <img class="tcard-photo" src="{{ 'dr-broussard.webp' | asset_url }}" alt="{{ section.settings.provider_name | escape }}">
        {%- endif -%}
      </div>
    </div>
    <div class="provider-copy">
      <p class="eyebrow">Provider network</p>
      <h2>Meet a prescribing provider</h2>
      <p class="provider-name">{{ section.settings.provider_name }} <span class="provider-npi">{{ section.settings.provider_npi }}</span></p>
      <p>{{ section.settings.provider_bio }}</p>
      <p class="provider-note">{{ section.settings.provider_disclaimer }}</p>
      <ul class="provider-list">
        <li><span class="check">✓</span> Independent, licensed physician (MD)</li>
        <li><span class="check">✓</span> Credentials verifiable via the public NPPES registry</li>
        <li><span class="check">✓</span> Independent clinical discretion on every case</li>
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Provider",
  "settings": [
    { "type": "image_picker", "id": "headshot", "label": "Provider headshot" },
    { "type": "text", "id": "provider_name", "label": "Provider name", "default": "Dr. Crystal Broussard, MD" },
    { "type": "text", "id": "provider_npi", "label": "NPI", "default": "NPI 1588688576" },
    { "type": "textarea", "id": "provider_bio", "label": "Bio", "default": "Dr. Broussard is an independent, licensed physician who provides medical oversight for the Velacore platform. She reviews member intake forms, determines treatment eligibility, issues prescriptions when clinically appropriate, and oversees patient safety. The Velacore care team is the primary point of contact for members and is trained on physician-approved protocols; clinically significant concerns are escalated to the prescribing provider for review." },
    { "type": "textarea", "id": "provider_disclaimer", "label": "Disclaimer", "default": "Dr. Broussard is an independent provider. She is not employed by, and does not serve as the medical director for, Velacore Health. Medical decisions are made solely at her independent clinical discretion. Your prescribing provider may vary based on state availability and clinical need." }
  ],
  "presets": [{ "name": "Provider" }]
}
{% endschema %}
